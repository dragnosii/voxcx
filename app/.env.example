# Copier ce fichier en .env et remplir les valeurs. Le fichier .env n'est jamais publié.
# Clé de l'IA en ligne (facultative : sans clé, la plateforme fonctionne en mode local gratuit)
ANTHROPIC_API_KEY=
# Modèle Claude utilisé
MODELE_CLAUDE=claude-sonnet-5-5
# Clé de signature des sessions : créée automatiquement au premier lancement si absente
VOXCX_SECRET=
# 1 = paiement de démonstration (aucun prélèvement réel)
VOXCX_PAIEMENT_DEMO=1
# 1 en production derrière HTTPS (cookies Secure + HSTS)
VOXCX_PRODUCTION=0
