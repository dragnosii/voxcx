# Copier ce fichier en .env et remplir les valeurs. Le fichier .env n'est jamais publié.
# IA en ligne (facultative : sans clé, la plateforme fonctionne en mode local gratuit)
# Clé OpenRouter (prioritaire) : le niveau Économique / Équilibré / Puissant se choisit dans l'administration
OPENROUTER_API_KEY=
# Modèles des 3 niveaux (facultatif, valeurs par défaut dans plateforme/config.py)
MODELE_ECONOMIQUE=deepseek/deepseek-v4.1-flash
MODELE_EQUILIBRE=anthropic/claude-haiku-5.5
MODELE_PUISSANT=anthropic/claude-sonnet-5.5
# Ou clé Anthropic directe (utilisée seulement si pas de clé OpenRouter)
ANTHROPIC_API_KEY=
MODELE_CLAUDE=claude-sonnet-5-5
# Clé de signature des sessions : créée automatiquement au premier lancement si absente
VOXCX_SECRET=
# 1 = paiement de démonstration (aucun prélèvement réel)
VOXCX_PAIEMENT_DEMO=1
# 1 en production derrière HTTPS (cookies Secure + HSTS)
VOXCX_PRODUCTION=0
